# Copy this file to .env before running:
#   cp .env_example .env

# Common
VMDOCKER_URL=http://127.0.0.1:8080
VMDOCKER_PRIVATE_KEY=

# Choose one module generation mode below.

# Pull mode
# Example OpenClaw image:
# VMDOCKER_SANDBOX_IMAGE_NAME=chriswebber/docker-openclaw:latest
# Example Claude image:
# VMDOCKER_SANDBOX_IMAGE_NAME=chriswebber/docker-claude:latest
# VMDOCKER_SANDBOX_IMAGE_ID=

# Local build mode
# VMDOCKER_BUILD_DOCKERFILE=./Dockerfile.openclaw
# VMDOCKER_BUILD_DOCKERFILE=./Dockerfile.claude
# VMDOCKER_BUILD_CONTEXT_DIR=.
# VMDOCKER_BUILD_TAG=chriswebber/docker-claude:latest

# Remote build mode
# VMDOCKER_BUILD_DOCKERFILE_PATH=Dockerfile.claude
# VMDOCKER_BUILD_CONTEXT_URL=https://github.com/your-org/your-repo.git#main
# VMDOCKER_BUILD_TAG=chriswebber/docker-claude:latest

# Optional build args
# VMDOCKER_BUILD_ARG_HTTP_PROXY=http://host.docker.internal:7890
# VMDOCKER_BUILD_ARG_HTTPS_PROXY=http://host.docker.internal:7890
